##FILTER=<ID=soft_clip_ratio,Description="Ratio of soft-clipped bases supporting the variant is above the threshold of 0.8">
##FILTER=<ID=str_contraction,Description="Site filtered due to suspected PCR error where the alt allele is one repeat unit less than the reference">
##FILTER=<ID=too_few_supporting_reads,Description="Site filtered because there are too few supporting reads (less than 1) in the tumor sample.">
